# Django Core Settings
DJANGO_SECRET_KEY=smarthire-ai-secure-prod-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Neon PostgreSQL connection string (pooled recommended for web apps, unpooled for direct migrations):
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password@ep-xxxx.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_ENGINE=postgresql
# Or separate params:
# POSTGRES_DB=smarthire_db
# POSTGRES_USER=smarthire_user
# POSTGRES_PASSWORD=smarthire_secure_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis & Celery (runs eagerly in-process when CELERY_TASK_ALWAYS_EAGER=True)
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# AI Provider API Keys — add GROQ_API_KEY alone for full LLM-powered features
GROQ_API_KEY=
GROQ_MODEL_NAME=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1500

# SMTP Email Integration (uses console email backend when EMAIL_HOST is blank)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SmartHire AI <noreply@smarthire.local>

# Optional Enterprise SSO / OAuth2 Client IDs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# CORS & CSRF Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
