# Django Settings
DJANGO_SECRET_KEY=smarthire-ai-secure-prod-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for instant local run, or PostgreSQL)
DATABASE_ENGINE=sqlite
# For PostgreSQL:
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=smarthire_db
# POSTGRES_USER=smarthire_user
# POSTGRES_PASSWORD=smarthire_secure_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# AI Provider Settings
AI_PROVIDER=mock_fallback
# Optional OpenAI / Groq keys:
OPENAI_API_KEY=
GROQ_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1500

# CORS & Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
